{
  "manifest_version": 3,
  "name": "ATS Resume Studio Clipper",
  "version": "1.0.0",
  "description": "1-Click import job postings from Indeed, LinkedIn, and any job board directly into your ATS Resume Studio.",
  "icons": {
    "32": "icon.png"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.indeed.com/*",
    "*://*.linkedin.com/*",
    "*://*/*",
    "http://localhost:3001/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Send Job to ATS Resume Studio",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.indeed.com/*",
        "*://*.linkedin.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
